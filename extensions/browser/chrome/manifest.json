{
  "manifest_version": 3,
  "name": "pad capture",
  "version": "0.1.0",
  "description": "Capture content to pad daemon",
  "permissions": ["contextMenus", "activeTab"],
  "host_permissions": ["http://localhost:7778/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
